{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gef:schema:cli-upgrade-compatibility-matrix-schema:1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "$id", "schemaVersion", "product", "supportedPlatforms", "minimumNodeMajor", "requiredCapabilities", "compatibility"],
  "properties": {
    "$schema": { "const": "https://json-schema.org/draft/2020-12/schema" },
    "$id": { "const": "urn:gef:schema:cli-upgrade-compatibility-matrix:1" },
    "schemaVersion": { "const": 1 },
    "product": { "const": "gef-bootstrap" },
    "supportedPlatforms": { "type": "array", "items": { "enum": ["win32", "linux", "darwin"] }, "minItems": 3, "maxItems": 3, "uniqueItems": true },
    "minimumNodeMajor": { "type": "integer", "minimum": 22 },
    "requiredCapabilities": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 4, "uniqueItems": true },
    "compatibility": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to", "stateSchemaMajor", "receiptSchemaMajor", "migrationId", "migrationOrder", "recoveryStrategy", "evidenceState", "evidenceRefs"],
        "properties": {
          "from": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
          "to": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
          "stateSchemaMajor": { "type": "integer", "minimum": 1 },
          "receiptSchemaMajor": { "type": "integer", "minimum": 1 },
          "migrationId": { "type": "string", "minLength": 1 },
          "migrationOrder": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
          "recoveryStrategy": { "type": "string", "minLength": 1 },
          "evidenceState": { "enum": ["PROVISIONAL", "VERIFIED"] },
          "evidenceRefs": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1, "uniqueItems": true }
        }
      }
    }
  }
}
