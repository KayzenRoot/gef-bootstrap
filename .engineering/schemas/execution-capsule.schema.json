{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gef:schema:execution-capsule:1",
  "title": "GEF Execution Capsule",
  "description": "Deterministic, fingerprinted execution context compiled for an external executor. Fail-closed: insufficient context certainty is INDETERMINATE, never a compiled capsule.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "capsuleId",
    "capsuleVersion",
    "releaseLine",
    "state",
    "certainty",
    "base",
    "workOrder",
    "navigation",
    "affected",
    "constraints",
    "acceptanceCriteria",
    "selectedTests",
    "proofReferences",
    "fingerprints",
    "invalidation",
    "stopCondition"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "capsuleId": {
      "type": "string",
      "pattern": "^gef\\.capsule\\.[a-z0-9][a-z0-9-]*\\.[a-z0-9][a-z0-9-]*$"
    },
    "capsuleVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "releaseLine": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.x$"
    },
    "state": {
      "enum": [
        "COMPILED",
        "INDETERMINATE",
        "STALE",
        "REJECTED"
      ]
    },
    "certainty": {
      "enum": [
        "SUFFICIENT",
        "INSUFFICIENT"
      ]
    },
    "base": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "branch",
        "headSha",
        "treeFingerprint",
        "productionBranchTouched"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$"
        },
        "branch": {
          "type": "string",
          "minLength": 1
        },
        "headSha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "treeFingerprint": {
          "$ref": "#/$defs/sha256"
        },
        "productionBranchTouched": {
          "const": false
        }
      }
    },
    "workOrder": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source",
        "scopeDigest"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^GBS-[A-Z0-9-]+$"
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "scopeDigest": {
          "$ref": "#/$defs/sha256"
        },
        "assurance": {
          "enum": [
            "STANDARD",
            "ELEVATED"
          ]
        }
      }
    },
    "navigation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mustRead",
        "writeAllowed",
        "writeForbidden",
        "searchSuppressed"
      ],
      "properties": {
        "mustRead": {
          "$ref": "#/$defs/sortedPathList"
        },
        "readIfTriggered": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "trigger"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "trigger": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "writeAllowed": {
          "$ref": "#/$defs/sortedPathList"
        },
        "writeForbidden": {
          "$ref": "#/$defs/sortedPathList"
        },
        "searchSuppressed": {
          "const": true
        }
      }
    },
    "affected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "files",
        "dependencyClosureDigest"
      ],
      "properties": {
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "mode",
              "fingerprint"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "mode": {
                "enum": [
                  "NEW_FILE_SEED",
                  "EXISTING_FILE_PATCH_INTENT",
                  "STRUCTURE_ONLY",
                  "READ_ONLY"
                ]
              },
              "fingerprint": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/sha256"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        },
        "symbols": {
          "$ref": "#/$defs/sortedStringList"
        },
        "dependencies": {
          "$ref": "#/$defs/sortedStringList"
        },
        "dependencyClosureDigest": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "constraints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "acceptanceCriteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "criterion",
          "proofObligation"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "criterion": {
            "type": "string",
            "minLength": 1
          },
          "proofObligation": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "selectedTests": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ladderLevel",
        "tests",
        "escalation",
        "finalSweepRequired"
      ],
      "properties": {
        "ladderLevel": {
          "enum": [
            "L0",
            "L1",
            "L2",
            "L3",
            "L4",
            "L5"
          ]
        },
        "tests": {
          "$ref": "#/$defs/sortedStringList"
        },
        "escalation": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "trigger",
              "escalateTo"
            ],
            "properties": {
              "trigger": {
                "type": "string",
                "minLength": 1
              },
              "escalateTo": {
                "enum": [
                  "L0",
                  "L1",
                  "L2",
                  "L3",
                  "L4",
                  "L5"
                ]
              }
            }
          }
        },
        "finalSweepRequired": {
          "type": "boolean"
        }
      }
    },
    "proofReferences": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "proofId",
          "state",
          "bindsTo",
          "manufacturesProductionCredit"
        ],
        "properties": {
          "proofId": {
            "type": "string",
            "minLength": 1
          },
          "state": {
            "enum": [
              "REUSABLE",
              "STALE_SOURCE",
              "STALE_TEST",
              "STALE_CONFIG",
              "STALE_TOOLCHAIN",
              "PLATFORM_MISMATCH",
              "DEPENDENCY_UNKNOWN",
              "CONFLICT",
              "INDETERMINATE"
            ]
          },
          "bindsTo": {
            "$ref": "#/$defs/sha256"
          },
          "manufacturesProductionCredit": {
            "const": false
          }
        }
      }
    },
    "fingerprints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonicalization",
        "capsuleFingerprint"
      ],
      "properties": {
        "canonicalization": {
          "type": "string",
          "minLength": 1
        },
        "capsuleFingerprint": {
          "$ref": "#/$defs/sha256"
        },
        "inputs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "ref",
              "fingerprint"
            ],
            "properties": {
              "ref": {
                "type": "string",
                "minLength": 1
              },
              "fingerprint": {
                "$ref": "#/$defs/sha256"
              }
            }
          }
        }
      }
    },
    "invalidation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "driftClasses",
        "onDrift"
      ],
      "properties": {
        "driftClasses": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "NONE",
              "LOCAL_COMPATIBLE",
              "SEED_RECOMPILE_REQUIRED",
              "CONTEXT_EXPANSION_REQUIRED",
              "CONFLICT"
            ]
          }
        },
        "onDrift": {
          "enum": [
            "RECOMPILE",
            "EXPAND_CONTEXT",
            "ESCALATE",
            "HALT"
          ]
        },
        "expiresAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "stopCondition": {
      "type": "string",
      "minLength": 1
    },
    "openQuestions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sortedPathList": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "sortedStringList": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "certainty"
        ],
        "properties": {
          "certainty": {
            "const": "INSUFFICIENT"
          }
        }
      },
      "then": {
        "properties": {
          "state": {
            "const": "INDETERMINATE"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "state"
        ],
        "properties": {
          "state": {
            "const": "COMPILED"
          }
        }
      },
      "then": {
        "properties": {
          "certainty": {
            "const": "SUFFICIENT"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "selectedTests"
        ],
        "properties": {
          "selectedTests": {
            "required": [
              "ladderLevel"
            ],
            "properties": {
              "ladderLevel": {
                "const": "L5"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "selectedTests": {
            "required": [
              "finalSweepRequired"
            ],
            "properties": {
              "finalSweepRequired": {
                "const": true
              }
            }
          }
        }
      }
    }
  ],
  "examples": []
}
